# Copy to apps/api/.env and apps/web/.env.local as needed. NEVER commit real secrets.

# Database
DATABASE_URL=postgresql://travelos:travelos@localhost:5432/travelos?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
JWT_SECRET=change-me-to-another-long-random-string

# API
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# OpenAI (Sprint 2+)
OPENAI_API_KEY=

# Object storage (optional in Sprint 1 — local disk fallback)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
