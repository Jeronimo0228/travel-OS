generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  ASESOR
}

enum AgencyKind {
  AGENCY
  WHOLESALER
}

enum PartnershipStatus {
  PENDING
  ACTIVE
  ENDED
}

enum ProgramBookingStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
}

enum LeadStage {
  PROSPECTO
  COTIZANDO
  CIERRE
  GANADO
  PERDIDO
}

enum CatalogKind {
  HOTEL
  ACTIVITY
}

enum CatalogPricingUnit {
  PER_NIGHT
  PER_PERSON
}

enum PdfStatus {
  NOT_REQUESTED
  PENDING
  READY
  FAILED
}

enum PortalMessageSender {
  TRAVELER
  AGENCY
}

model Agency {
  id           String     @id @default(cuid())
  name         String
  nit          String     @unique
  slug         String     @unique
  logoUrl      String?
  primaryColor String     @default("#4648d4")
  /// HU-24: knowledge base injected into AI prompts.
  aiTone       String     @default("")
  aiPolicies   String     @default("")
  aiFaqs       Json       @default("[]")
  /// HU-33: una agencia puede operar como mayorista.
  kind         AgencyKind @default(AGENCY)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  users                User[]
  leads                Lead[]
  tasks                Task[]
  auditLogs            AuditLog[]
  catalogItems         CatalogItem[]
  quotes               Quote[]
  reservations         Reservation[]
  taskReminders        TaskReminder[]
  invitations          UserInvitation[]
  programs             Program[]        @relation("WholesalerPrograms")
  partnersAsWholesaler Partnership[]    @relation("PartnershipWholesaler")
  partnersAsAgency     Partnership[]    @relation("PartnershipAgency")
  bookingsAsAgency     ProgramBooking[] @relation("BookingAgency")
  bookingsAsWholesaler ProgramBooking[] @relation("BookingWholesaler")
}

model User {
  id             String    @id @default(cuid())
  agencyId       String
  email          String
  passwordHash   String
  name           String
  role           Role      @default(ASESOR)
  /// HU-38: usuario desactivado por el administrador.
  disabledAt     DateTime?
  /// Sube al cambiar contraseña o desactivar: invalida los JWT emitidos antes.
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agency          Agency               @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedLeads   Lead[]               @relation("LeadAssignee")
  tasks           Task[]
  auditLogs       AuditLog[]
  createdQuotes   Quote[]
  portalMessages  ChatMessage[]
  taskReminders   TaskReminder[]
  passwordResets  PasswordResetToken[]
  invitationsSent UserInvitation[]     @relation("InvitationCreatedBy")

  @@unique([agencyId, email])
  @@index([agencyId])
}

model Lead {
  id          String    @id @default(cuid())
  agencyId    String
  name        String
  email       String?
  phone       String?
  destination String?
  notes       String?
  stage       LeadStage @default(PROSPECTO)
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("LeadAssignee", fields: [assigneeId], references: [id])
  tasks        Task[]
  quotes       Quote[]
  reservations Reservation[]

  @@index([agencyId, stage])
  @@index([agencyId, assigneeId])
}

model CatalogItem {
  id          String             @id @default(cuid())
  agencyId    String
  slug        String
  kind        CatalogKind
  name        String
  destination String
  description String
  pricingUnit CatalogPricingUnit
  price       Decimal            @db.Decimal(12, 2)
  currency    String             @default("COP")
  /// HU-34: los ítems archivados no se usan en nuevas cotizaciones.
  archivedAt  DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  quoteItems QuoteOptionItem[]

  @@unique([agencyId, slug])
  @@index([agencyId, kind, destination])
}

model Quote {
  id            String    @id @default(cuid())
  agencyId      String
  createdById   String
  leadId        String?
  prompt        String
  destination   String
  durationDays  Int
  travelerCount Int
  pdfStatus     PdfStatus @default(NOT_REQUESTED)
  pdfData       Bytes?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  options   QuoteOption[]

  @@index([agencyId, createdAt])
  @@index([agencyId, leadId])
  @@index([agencyId, createdById])
}

model QuoteOption {
  id         String            @id @default(cuid())
  quoteId    String
  position   Int
  title      String
  summary    String
  totalPrice Decimal           @db.Decimal(12, 2)
  currency   String            @default("COP")
  items      QuoteOptionItem[]

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, position])
}

model QuoteOptionItem {
  id                  String             @id @default(cuid())
  quoteOptionId       String
  catalogItemId       String
  nameSnapshot        String
  descriptionSnapshot String
  pricingUnit         CatalogPricingUnit
  quantity            Int
  unitPrice           Decimal            @db.Decimal(12, 2)

  quoteOption QuoteOption @relation(fields: [quoteOptionId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([quoteOptionId])
}

model Task {
  id          String    @id @default(cuid())
  agencyId    String
  leadId      String
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  agency    Agency         @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?          @relation(fields: [createdById], references: [id])
  reminders TaskReminder[]

  @@index([agencyId, leadId])
}

model Reservation {
  id            String   @id @default(cuid())
  agencyId      String
  leadId        String
  travelerName  String
  travelerEmail String
  destination   String
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agency       Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead         Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  itinerary    ItineraryItem[]
  documents    ReservationDocument[]
  messages     ChatMessage[]
  accessTokens PortalAccessToken[]

  @@index([agencyId, startsAt])
  @@index([agencyId, leadId])
}

model ItineraryItem {
  id            String    @id @default(cuid())
  reservationId String
  title         String
  details       String?
  location      String?
  startsAt      DateTime?
  endsAt        DateTime?
  position      Int       @default(0)
  createdAt     DateTime  @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, position])
}

model ReservationDocument {
  id            String   @id @default(cuid())
  reservationId String
  name          String
  url           String
  contentType   String?
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
}

model PortalAccessToken {
  id            String   @id @default(cuid())
  reservationId String
  tokenHash     String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, expiresAt])
}

model ChatMessage {
  id            String              @id @default(cuid())
  reservationId String
  sender        PortalMessageSender
  senderUserId  String?
  body          String
  createdAt     DateTime            @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  senderUser  User?       @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([reservationId, createdAt])
}

model TaskReminder {
  id          String    @id @default(cuid())
  agencyId    String
  taskId      String
  dueAt       DateTime
  recipientId String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient User?  @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([taskId, dueAt])
  @@index([agencyId, recipientId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  agencyId  String
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([agencyId, createdAt])
}

/// HU-37: enlace de un solo uso para restablecer la contraseña (solo se guarda el hash).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// HU-38: invitación de un usuario a la agencia.
model UserInvitation {
  id          String    @id @default(cuid())
  agencyId    String
  email       String
  role        Role      @default(ASESOR)
  tokenHash   String    @unique
  createdById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("InvitationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([agencyId])
}

/// HU-31: contadores de límite de uso compartidos entre instancias.
model RateCounter {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// HU-31: llave de IA en descanso, identificada por el SHA-256 de la llave (nunca la llave).
model AiKeyCooldown {
  keyHash String   @id
  until   DateTime
}

/// HU-33: relación entre un mayorista y una agencia aliada.
model Partnership {
  id            String            @id @default(cuid())
  wholesalerId  String
  agencyId      String
  commissionPct Decimal           @db.Decimal(5, 2)
  status        PartnershipStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  wholesaler Agency @relation("PartnershipWholesaler", fields: [wholesalerId], references: [id], onDelete: Cascade)
  agency     Agency @relation("PartnershipAgency", fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([wholesalerId, agencyId])
  @@index([agencyId])
}

/// HU-33: programa de varios días que el mayorista vende por medio de sus aliadas.
model Program {
  id           String    @id @default(cuid())
  wholesalerId String
  name         String
  destination  String
  days         Int
  description  String    @default("")
  netPrice     Decimal   @db.Decimal(12, 2)
  currency     String    @default("COP")
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wholesaler Agency      @relation("WholesalerPrograms", fields: [wholesalerId], references: [id], onDelete: Cascade)
  departures Departure[]

  @@index([wholesalerId])
}

model Departure {
  id        String   @id @default(cuid())
  programId String
  startsOn  DateTime
  seats     Int
  createdAt DateTime @default(now())

  program  Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  bookings ProgramBooking[]

  @@index([programId, startsOn])
}

model ProgramBooking {
  id              String               @id @default(cuid())
  departureId     String
  agencyId        String
  wholesalerId    String
  travelerName    String
  pax             Int
  status          ProgramBookingStatus @default(REQUESTED)
  netTotal        Decimal              @db.Decimal(12, 2)
  commissionPct   Decimal              @db.Decimal(5, 2)
  commissionTotal Decimal              @db.Decimal(12, 2)
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  departure  Departure @relation(fields: [departureId], references: [id], onDelete: Cascade)
  agency     Agency    @relation("BookingAgency", fields: [agencyId], references: [id], onDelete: Cascade)
  wholesaler Agency    @relation("BookingWholesaler", fields: [wholesalerId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([wholesalerId])
  @@index([departureId])
}
