generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERENTE
  ASESOR
}

enum LeadStage {
  PROSPECTO
  COTIZANDO
  CIERRE
  GANADO
  PERDIDO
}

enum CatalogKind {
  HOTEL
  ACTIVITY
}

enum CatalogPricingUnit {
  PER_NIGHT
  PER_PERSON
}

enum PdfStatus {
  NOT_REQUESTED
  PENDING
  READY
  FAILED
}

model Agency {
  id           String   @id @default(cuid())
  name         String
  nit          String   @unique
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#4648d4")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users        User[]
  leads        Lead[]
  tasks        Task[]
  auditLogs    AuditLog[]
  catalogItems CatalogItem[]
  quotes       Quote[]
}

model User {
  id           String   @id @default(cuid())
  agencyId     String
  email        String
  passwordHash String
  name         String
  role         Role     @default(ASESOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agency        Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]     @relation("LeadAssignee")
  tasks         Task[]
  auditLogs     AuditLog[]
  createdQuotes Quote[]

  @@unique([agencyId, email])
  @@index([agencyId])
}

model Lead {
  id          String    @id @default(cuid())
  agencyId    String
  name        String
  email       String?
  phone       String?
  destination String?
  notes       String?
  stage       LeadStage @default(PROSPECTO)
  assigneeId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  assignee User?   @relation("LeadAssignee", fields: [assigneeId], references: [id])
  tasks    Task[]
  quotes   Quote[]

  @@index([agencyId, stage])
  @@index([agencyId, assigneeId])
}

model CatalogItem {
  id          String             @id @default(cuid())
  agencyId    String
  slug        String
  kind        CatalogKind
  name        String
  destination String
  description String
  pricingUnit CatalogPricingUnit
  price       Decimal            @db.Decimal(12, 2)
  currency    String             @default("COP")
  createdAt   DateTime           @default(now())

  agency     Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  quoteItems QuoteOptionItem[]

  @@unique([agencyId, slug])
  @@index([agencyId, kind, destination])
}

model Quote {
  id            String    @id @default(cuid())
  agencyId      String
  createdById   String
  leadId        String?
  prompt        String
  destination   String
  durationDays  Int
  travelerCount Int
  pdfStatus     PdfStatus @default(NOT_REQUESTED)
  pdfData       Bytes?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  agency    Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  options   QuoteOption[]

  @@index([agencyId, createdAt])
  @@index([agencyId, leadId])
  @@index([agencyId, createdById])
}

model QuoteOption {
  id         String            @id @default(cuid())
  quoteId    String
  position   Int
  title      String
  summary    String
  totalPrice Decimal           @db.Decimal(12, 2)
  currency   String            @default("COP")
  items      QuoteOptionItem[]

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, position])
}

model QuoteOptionItem {
  id                  String             @id @default(cuid())
  quoteOptionId       String
  catalogItemId       String
  nameSnapshot        String
  descriptionSnapshot String
  pricingUnit         CatalogPricingUnit
  quantity            Int
  unitPrice           Decimal            @db.Decimal(12, 2)

  quoteOption QuoteOption @relation(fields: [quoteOptionId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([quoteOptionId])
}

model Task {
  id          String    @id @default(cuid())
  agencyId    String
  leadId      String
  title       String
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?

  agency    Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id])

  @@index([agencyId, leadId])
}

model AuditLog {
  id        String   @id @default(cuid())
  agencyId  String
  userId    String?
  action    String
  meta      Json?
  createdAt DateTime @default(now())

  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  @@index([agencyId, createdAt])
}
